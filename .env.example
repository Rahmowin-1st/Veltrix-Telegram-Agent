# Core
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=10000
OWNER_TELEGRAM_ID=

# Gemini. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SEARCH_MODEL=gemini-3.8-flash
AI_STARTUP_CHECK=true

# Telegram Bot API / Business bot
TELEGRAM_BOT_TOKEN=

# Webhook mode (recommended for Render free)
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=

# Telegram MTProto user session (required for user-only account controls)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Database: leave blank for local sqlite. Use Postgres in production for durable memory.
DATABASE_URL=

# Agent policy
AUTO_REPLY_BUSINESS=false
REQUIRE_CONFIRMATION=true
MAX_HISTORY_MESSAGES=30
MAX_AGENT_STEPS=12
WRITE_RATE_PER_MINUTE=20
DOWNLOAD_MAX_MB=25
ALLOWED_FETCH_SCHEMES=https
